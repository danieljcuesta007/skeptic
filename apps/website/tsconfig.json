{
  "compilerOptions": {
    "target": "ES2022", "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "react-jsx", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "skipLibCheck": true,
    "paths": { "@/*": ["./*"] }
  },
  "include": ["*.d.ts", "*.tsx", "components/**/*.tsx", "lib/**/*.ts"]
}
